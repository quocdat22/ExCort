# Copy this file to .env and fill in both values before phases 2 and 4.
OPENROUTER_API_KEY=
JINA_API_KEY=

# Model choices required by the MVP specification.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731
JINA_EMBEDDING_MODEL=jina-embeddings-v5-omni-small

PDF_PATH=data/raw/demo.pdf
MAX_UPLOAD_SIZE_MB=5
CHROMA_PATH=data/chroma
CHROMA_COLLECTION=excort_documents
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=4
BACKEND_URL=http://127.0.0.1:8000
